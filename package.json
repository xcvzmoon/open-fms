{
  "name": "buildr",
  "description": "An opinionated monorepo foundation for building modern full-stack TypeScript applications",
  "version": "0.0.6",
  "type": "module",
  "private": true,
  "scripts": {
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "build": "vp run --recursive build",
    "typecheck": "vp run --recursive typecheck",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:verbose": "vp test --reporter=verbose",
    "release": "genbumppush --yes",
    "api": "vp run --filter open-fms-api"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "genbumppush": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}

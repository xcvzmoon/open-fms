{
  "name": "buildr",
  "description": "An opinionated monorepo foundation for building modern full-stack TypeScript applications",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "build": "vp run --recursive build",
    "typecheck": "vp run --recursive typecheck",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:verbose": "vp test --reporter=verbose",
    "release": "genbumppush --yes",
    "api": "vpr --filter api",
    "web": "vpr --filter web",
    "database": "vpr --filter database",
    "shared": "vpr --filter shared",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:migrate": "docker compose run --rm migrate"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "genbumppush": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  }
}
